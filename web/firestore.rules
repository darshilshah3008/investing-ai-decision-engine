rules_version = '2';

// Firestore security rules.
// - Verdicts are READ-ONLY public (cached engine output, safe to share).
// - Tickers are READ-ONLY public (SEC ticker master cache).
// - Watchlists belong to the owning user.
// - Per-user state lives under users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    // SEC ticker master cache — anyone can read, only server (admin SDK) writes.
    match /tickers/{tickerId} {
      allow read: if true;
      allow write: if false;
    }

    // Pre-computed verdicts cache — anyone can read, only server writes.
    match /verdicts/{verdictId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user document.
    // - User can READ their own profile (to see their tier).
    // - User CANNOT write — only the server admin SDK can mutate the user
    //   doc, so the client can never self-promote to a paid tier.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /watchlists/{watchlistId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Pre-computed universe table — read open to anyone, write server-only.
    // Used by the Pro-tier Universe page (a paid feature client-side, but
    // the data itself is non-secret cached engine output).
    match /universe/{ticker} {
      allow read: if true;
      allow write: if false;
    }

    // Waitlist — captured by /api/waitlist (admin SDK only). No client
    // reads (the list is not public) and no client writes (rate-limited
    // server-side route is the only ingress).
    match /waitlist/{entryId} {
      allow read, write: if false;
    }
  }
}
